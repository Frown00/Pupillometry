{
  "name": "pupillometry",
  "version": "1.1.3",
  "description": "App for preprocessing, visualize and analysis of pupil size",
  "scripts": {
    "build": "concurrently \"npm run build:main\" \"npm run build:renderer\"",
    "build:main": "cross-env NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.main.prod.ts",
    "build:renderer": "cross-env NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.renderer.prod.ts",
    "rebuild": "electron-rebuild --parallel --types prod,dev,optional --module-dir",
    "typecheck": "tsc --noEmit -p src/main/tsconfig.json && tsc --noEmit -p src/main/tsconfig.preload.json && tsc --noEmit -p src/renderer/tsconfig.json && tsc --noEmit -p src/tsconfig.test.json && tsc --noEmit",
    "lint": "npm run typecheck && cross-env NODE_ENV=development eslint . --cache --ext .js,.jsx,.ts,.tsx",
    "package": "ts-node ./.erb/scripts/clean.js dist && npm run build && electron-builder build -w zip --x64 --publish never",
    "postinstall": "ts-node .erb/scripts/check-native-dep.js && electron-builder install-app-deps && cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.renderer.dev.dll.ts && opencollective-postinstall",
    "start": "ts-node ./.erb/scripts/check-port-in-use.js && npm run start:renderer",
    "start:main": "cross-env NODE_ENV=development electron -r ts-node/register/transpile-only ./src/main/main.ts",
    "start:renderer": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack serve --config ./.erb/configs/webpack.config.renderer.dev.ts",
    "test": "vitest run",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "cross-env NODE_ENV=development eslint --cache"
    ],
    "*.json,.{eslintrc,prettierrc}": [
      "prettier --parser json --write"
    ],
    "*.{css,scss}": [
      "prettier --single-quote --write"
    ],
    "*.{html,md,yml}": [
      "prettier --single-quote --write"
    ]
  },
  "build": {
    "productName": "Pupillometry",
    "appId": "com.github.frown00.Pupillometry",
    "asar": true,
    "asarUnpack": "**\\*.{node,dll}",
    "files": [
      "dist",
      "node_modules",
      "package.json"
    ],
    "afterSign": ".erb/scripts/notarize.js",
    "mac": {
      "target": {
        "target": "default",
        "arch": [
          "arm64",
          "x64"
        ]
      },
      "type": "distribution",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Science"
    },
    "directories": {
      "app": "release/app",
      "buildResources": "assets",
      "output": "release/build"
    },
    "extraResources": [
      "./assets/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "Frown00",
      "repo": "Pupillometry"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Frown00/Pupillometry.git"
  },
  "author": {
    "name": "Fabian Kuriata",
    "email": "fabian.kuriata.dev@gmail.com",
    "url": "https://github.com/Frown00/Pupillometry.git"
  },
  "contributors": [],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Frown00/Pupillometry/issues"
  },
  "keywords": [
    "Pupillometry",
    "Pupil Diameter",
    "Pupil Size",
    "analysis",
    "visualization",
    "Pupil dilatation"
  ],
  "homepage": "https://github.com/Frown00/Pupillometry.git",
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@eslint/js": "^9.39.5",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@teamsupercell/typings-for-css-modules-loader": "^2.5.1",
    "@testing-library/jest-dom": "^5.14.1",
    "@testing-library/react": "^12.1.2",
    "@types/compression": "^1.7.2",
    "@types/d3": "^7.1.0",
    "@types/enzyme": "^3.10.10",
    "@types/enzyme-adapter-react-16": "^1.0.6",
    "@types/history": "4.7.9",
    "@types/node": "^22.20.7",
    "@types/react": "17.0.71",
    "@types/react-dom": "17.0.25",
    "@types/react-router": "5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-test-renderer": "^17.0.1",
    "@types/styled-components": "^5.1.21",
    "@types/terser-webpack-plugin": "^5.0.4",
    "@types/webpack-env": "^1.16.3",
    "browserslist-config-erb": "^0.0.3",
    "chalk": "^4.1.2",
    "concurrently": "^6.3.0",
    "core-js": "^3.19.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.5.0",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "detect-port": "^1.3.0",
    "electron": "^45.5.0",
    "electron-builder": "26.18.0",
    "electron-devtools-installer": "^3.2.0",
    "electron-notarize": "^1.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "file-loader": "^6.2.0",
    "globals": "^17.14.0",
    "html-webpack-plugin": "^5.5.0",
    "husky": "^7.0.4",
    "jsdom": "^31.0.1",
    "lint-staged": "^12.1.4",
    "mini-css-extract-plugin": "^2.4.5",
    "opencollective-postinstall": "^2.0.3",
    "prettier": "^2.5.1",
    "react-refresh": "^0.11.0",
    "react-refresh-typescript": "^2.0.3",
    "react-test-renderer": "^17.0.2",
    "regenerator-runtime": "^0.14.1",
    "rimraf": "^3.0.2",
    "sass": "^1.45.1",
    "sass-loader": "^12.4.0",
    "style-loader": "^3.3.1",
    "terser-webpack-plugin": "^5.2.4",
    "ts-loader": "^9.2.6",
    "ts-node": "^10.4.0",
    "typescript": "^4.9.5",
    "typescript-eslint": "^8.74.0",
    "url-loader": "^4.1.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.2",
    "webpack": "^5.65.0",
    "webpack-bundle-analyzer": "^5.4.3",
    "webpack-cli": "^4.9.1",
    "webpack-dev-server": "^6.1.0",
    "webpack-merge": "^5.8.0"
  },
  "dependencies": {
    "@ant-design/icons": "^4.7.0",
    "antd": "^4.18.2",
    "compression": "^1.7.4",
    "d3": "^7.2.1",
    "d3-svg-to-png": "^0.1.7",
    "electron-debug": "^3.2.0",
    "electron-log": "^4.4.4",
    "electron-store": "^8.0.1",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "formik": "^2.2.9",
    "history": "^5.2.0",
    "neat-csv": "^6.0.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-router": "5.2.1",
    "react-router-dom": "5.2.1",
    "recoil": "^0.5.2",
    "simple-statistics": "^7.7.0",
    "styled-components": "^5.3.3",
    "yup": "^0.32.11",
    "zipson": "^0.2.12"
  },
  "overrides": {
    "@electron/universal": {
      "minimatch": "^11.0.1"
    },
    "app-builder-lib": {
      "minimatch": "^11.0.1"
    },
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "@types/react": "17.0.71",
    "@types/react-router": "5.1.20"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.x",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.x",
      "onFail": "error"
    }
  },
  "browserslist": [],
  "prettier": {
    "overrides": [
      {
        "files": [
          ".prettierrc",
          ".eslintrc"
        ],
        "options": {
          "parser": "json"
        }
      }
    ],
    "singleQuote": true
  }
}
